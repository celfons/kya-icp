{
  "name": "kya-icp",
  "version": "0.1.0",
  "private": true,
  "description": "Coleta hor\u00e1ria das listas de certificados revogados (LCR) da ICP-Brasil, guardadas brutas no Cloudflare R2, para medir a taxa e o atraso de revoga\u00e7\u00e3o.",
  "license": "MIT",
